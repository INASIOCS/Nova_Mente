# Modelo dos *Secrets* do Streamlit Community Cloud.
#
# NÃO É PARA PREENCHER NESTE ARQUIVO. Ele é apenas o modelo versionado.
# O conteúdo real vai colado no painel da nuvem, em:
#   App -> Settings -> Secrets
# Localmente, continue usando o arquivo .env; o .streamlit/secrets.toml real
# está no .gitignore e nunca deve ser commitado.

# --- Obrigatório: chave do Google AI Studio ---
GOOGLE_API_KEY = "cole-aqui-a-sua-chave"

# --- Modelos (os que funcionam com a nossa chave) ---
GEMINI_MODEL = "gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"

# --- Economia de quota durante a demonstração ---
# A quota gratuita do Gemini é de 20 gerações por dia e 5 por minuto, e uma
# execução completa consome 3 chamadas (5 com revisão). Com as duas linhas
# abaixo, cada execução passa a consumir 2.
# AGENTE_ROTEADOR_ATIVO = "false"
# MAX_REVISOES = "0"

# --- Opcional: persistência no OCI Object Storage ---
# Sem esta seção a aplicação grava em disco local e avisa na interface que o
# backend obrigatório não foi exercitado — ela não finge sucesso.
# Atenção: preencher 'key_content' significa guardar uma chave privada no
# painel de um serviço de terceiros. Se preferir não fazer isso, deixe a seção
# comentada e demonstre o OCI pela sua máquina.
# [oci]
# user = "ocid1.user.oc1..."
# fingerprint = "aa:bb:cc:..."
# tenancy = "ocid1.tenancy.oc1..."
# region = "sa-saopaulo-1"
# namespace = "seu-namespace"
# bucket_name = "novamente-conteudos-educativos"
# key_content = """
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# """
