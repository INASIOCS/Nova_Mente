# ============================================================
# NovaMente — exemplo de configuração
# Copie para .env e preencha. O .env NUNCA deve ser commitado.
# ============================================================

# --- Provedor de LLM: "gemini" (padrão) ou "nvidia" ---
# Os embeddings seguem o mesmo provedor, a menos que EMBEDDING_PROVIDER diga
# o contrário. Cada variável deve aparecer UMA vez: em um .env, a última
# ocorrência vence e anula a anterior sem aviso.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=

# --- Google Gemini ---
GOOGLE_API_KEY=sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- NVIDIA (build.nvidia.com; endpoint gratuito, só para prototipagem) ---
# Use com LLM_PROVIDER=nvidia. A chave começa com "nvapi-".
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# Raciocínio do modelo antes de responder: mais lento e mais caro em tokens.
NVIDIA_THINKING=false

# --- Pipeline RAG ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5

# --- Camada de persistência: "local" ou "oci" ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage_local

# --- OCI Object Storage (camada Always Free) ---
# Preencher quando as credenciais do OCI estiverem disponíveis.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=novamente-conteudos-educativos
OCI_REGION=sa-saopaulo-1
# Opcional: so e usado por scripts/verificar_oci.py --criar-bucket.
# Vazio = compartimento raiz do tenancy.
OCI_COMPARTMENT_ID=

# --- Economia de quota do Gemini (free tier: ~20 geracoes/dia) ---
# Cada execucao usa 3 chamadas; 5 se houver rodada de revisao.
# Desativar o roteador reduz para 2; max_revisoes=0 evita a rodada extra.
AGENTE_ROTEADOR_ATIVO=true
MAX_REVISOES=1
LIMITE_REVISAO=0.80
